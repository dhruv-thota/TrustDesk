# ==============================================================================
# TrustDesk Environment Configuration Template
# ==============================================================================

# Database & Infrastructure Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trustdesk
POSTGRES_PORT=5433
REDIS_PORT=6379

# Local Host Connection URLs (used by host-level CLI and pytest suites)
# Note: When running inside Docker Compose, services automatically resolve
# internal network hostnames (postgres:5432 and redis:6379).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/trustdesk
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5433/trustdesk_test
REDIS_URL=redis://localhost:6379/0

# Authentication & Demo Session Security
TRUSTDESK_DEMO_TOKEN=demo_secret_token_123

# Application Runtime Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# AI Provider Configuration (mock | openrouter | live)
# Default is deterministic offline mock provider (no external API calls or keys needed)
AI_PROVIDER=mock

# OpenRouter / OpenAI-Compatible Configuration (required if AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=TrustDesk

# Google Gemini Configuration (required if AI_PROVIDER=live)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
