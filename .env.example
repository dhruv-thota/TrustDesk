# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/trustdesk
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5433/trustdesk_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trustdesk
POSTGRES_PORT=5433

# Authentication & Security
TRUSTDESK_DEMO_TOKEN=demo_secret_token_123

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# AI Provider Configuration (mock | openrouter | live)
AI_PROVIDER=mock

# OpenRouter / OpenAI Compatible Configuration (for AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5-mini

# Google Gemini Configuration (for AI_PROVIDER=live)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

